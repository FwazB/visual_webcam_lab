{
  "name": "body-synth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run prepare:lint && node scripts/prepare-vision.mjs",
    "dev": "next dev",
    "prebuild": "npm run prepare:lint && node scripts/prepare-vision.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "npm run prepare:lint && node scripts/prepare-vision.mjs",
    "test": "node --test --require ./tests/register.cjs tests/*.test.cjs src/lib/touchdesigner/*.test.ts",
    "test:fuzz": "python3 -m unittest discover -s touchdesigner/fuzz -p 'test_*.py'",
    "smoke": "node scripts/smoke.mjs",
    "prepare:lint": "node scripts/patch-lint-minimatch.cjs",
    "postinstall": "npm run prepare:lint",
    "prelint": "npm run prepare:lint"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "@techstark/opencv-js": "4.12.0-release.1",
    "next": "^16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "braces": "file:security/braces-depthguard",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "touchdesigner-mcp-server": "2.1.0",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "touchdesigner-mcp-server": {
      "zod": "4.6.6"
    },
    "minimatch@>=9": "11.0.3",
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array@0.21.2": {
      "minimatch": "11.0.3"
    },
    "@eslint/eslintrc@3.3.5": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-react@7.37.5": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-import@2.32.0": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-jsx-a11y@6.10.2": {
      "minimatch": "11.0.3"
    }
  }
}
